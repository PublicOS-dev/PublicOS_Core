  "fixed_sql": [
    {
      "name": "messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"id_xmtp\" TEXT NULL, \"xmtp_message_data\" TEXT NOT NULL, \"timestamp\" INTEGER NOT NULL, \"conversation_topic\" TEXT NOT NULL, \"sender_inbox_id\" TEXT NULL, \"client_address\" TEXT NOT NULL, \"type_id\" TEXT NULL, \"is_pending\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_pending\" IN (0, 1)), \"send_failed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"send_failed\" IN (0, 1)), UNIQUE (\"id_xmtp\", \"client_address\"));"
        }
      ]
    },
    {
      "name": "contacts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"contacts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"contactos_display_name\" TEXT NULL, \"contactos_address\" TEXT NULL, \"display_name\" TEXT NOT NULL, \"is_group_chat\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_group_chat\" IN (0, 1)), \"is_group_account\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_group_account\" IN (0, 1)), \"clients\" TEXT NULL, \"xmtp_inbox_id\" TEXT NULL, \"xmtp_conversation_topic\" TEXT NULL, \"xmtp_group_image_url_square\" TEXT NULL, \"xmtp_description\" TEXT NULL, \"xmtp_pinned_frame_url\" TEXT NULL, \"members_contacts\" TEXT NULL, \"created_by\" TEXT NULL, \"created_at\" TEXT NULL, \"is_blocked\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_blocked\" IN (0, 1)), \"is_support\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_support\" IN (0, 1)), \"records\" TEXT NULL, \"registered_inbox_i_ds\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, \"client_address\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"key\" TEXT NOT NULL, \"record\" TEXT NOT NULL, \"client_address\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, UNIQUE (\"key\", \"client_address\"));"
        }
      ]
    },
    {
      "name": "feed_servers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"feed_servers\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"feed_server_address\" TEXT NOT NULL, \"name\" TEXT NULL, \"is_default\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_default\" IN (0, 1)), \"client_address\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, UNIQUE (\"feed_server_address\", \"client_address\"));"
        }
      ]
    },
    {
      "name": "feed_lists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"feed_lists\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"icon\" TEXT NULL, \"client_address\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "list_feeds",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"list_feeds\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"list_id\" INTEGER NOT NULL REFERENCES feed_lists (id) ON DELETE CASCADE, \"feed_url\" TEXT NOT NULL, \"feed_title\" TEXT NULL, \"feed_description\" TEXT NULL, \"originating_account_address\" TEXT NULL, \"added_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "attachment_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attachment_cache\" (\"content_digest\" TEXT NOT NULL, \"filename\" TEXT NOT NULL, \"mime_type\" TEXT NOT NULL, \"data\" BLOB NOT NULL, \"size\" INTEGER NOT NULL, \"cached_at\" INTEGER NOT NULL, \"last_accessed\" INTEGER NOT NULL, PRIMARY KEY (\"content_digest\"));"
        }
      ]
    },
    {
      "name": "bookmarked_apps",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookmarked_apps\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"app_name\" TEXT NOT NULL, \"owner_address\" TEXT NOT NULL, \"display_name\" TEXT NOT NULL, \"icon_url\" TEXT NULL, \"description\" TEXT NULL, \"warnings\" TEXT NULL, \"category_one\" TEXT NULL, \"category_two\" TEXT NULL, \"url\" TEXT NULL, \"appstore_link\" TEXT NULL, \"playstore_link\" TEXT NULL, \"apk_download\" TEXT NULL, \"ipa_download\" TEXT NULL, \"client_address\" TEXT NOT NULL, \"bookmarked_at\" INTEGER NOT NULL, UNIQUE (\"app_name\", \"owner_address\", \"client_address\"));"
        }
      ]
    }
  ]
